# ─────────────────────────────────────────────────────────────────────────────
# Student Doubt Forum — Client Environment Configuration
# Copy this file to .env.local and fill in real values.
# Only VITE_ prefixed variables are exposed to the browser.
# NEVER place secrets here.
# ─────────────────────────────────────────────────────────────────────────────

# In development the Vite proxy (vite.config.js) forwards /api/* requests to
# the backend, so this variable is NOT needed during local development.
# Set it in production when the API is hosted on a different origin.
VITE_API_URL=http://localhost:5000
