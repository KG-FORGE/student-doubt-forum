# ─────────────────────────────────────────────────────────────────────────────
# Student Doubt Forum — Server Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development            # development | production | test

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/student-doubt-forum
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/student-doubt-forum?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/student-doubt-forum

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Production secrets MUST be at least 64 characters.
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS / Client ─────────────────────────────────────────────────────────────
# The exact origin of the React client. Used to configure CORS in production.
# In development the Vite proxy handles cross-origin requests automatically.
CLIENT_ORIGIN=http://localhost:5173

# ── Email (Optional) ──────────────────────────────────────────────────────────
# Leave ALL email variables empty to run without email delivery.
# When empty, emails are logged to the console in development and gracefully
# skipped — the server will clearly report that email is not configured.
# Supports: Gmail (app password), SendGrid SMTP, Mailgun SMTP, any SMTP relay.
#
# Gmail example:
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_SECURE=false
#   EMAIL_USER=you@gmail.com
#   EMAIL_PASS=your-app-password   (create at myaccount.google.com/apppasswords)
#
# SendGrid example:
#   EMAIL_HOST=smtp.sendgrid.net
#   EMAIL_PORT=587
#   EMAIL_USER=apikey
#   EMAIL_PASS=SG.your-sendgrid-api-key
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@doubtforum.local

# ── Admin Seed Script ─────────────────────────────────────────────────────────
# Used ONLY by: npm run seed:admin
# Run this once to create the first administrator account.
# Remove or rotate these values immediately after running the seed script.
# NEVER set these in a shared or production .env without rotating them after use.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=ChangeThisImmediately123!
ADMIN_SEED_NAME=Platform Admin
